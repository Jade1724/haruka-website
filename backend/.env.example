# Backend configuration. Copy to `.env` and fill in. Values map to fields in
# app/core/config.py (case-insensitive). `.env` must never be committed.

# --- Dev journal source (GitHub / Obsidian) -------------------------------
# GitHub PAT with read access to the private Obsidian repo.
GITHUB_TOKEN=
GITHUB_REPO=Jade1724/obsidian
JOURNALS_BASE_PATH=Dev/Journals
CACHE_TTL_SECONDS=600

# --- Contact form (SMTP) ---------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# Log verbosity: DEBUG | INFO | WARNING | ERROR. DEBUG also un-mutes the
# Azure / OpenAI SDK logs (the verbose HTTP header dumps).
LOG_LEVEL=INFO

# --- RAG chatbot (mecha-haruka) feature flag -------------------------------
# Off by default: running the chatbot costs money (Azure OpenAI + AI Search).
# Set to true (and fill in the Azure settings below) to enable POST /chat.
CHAT_ENABLED=false

# --- Azure OpenAI (chat + embeddings, for /chat) --------------------------
# Endpoint + key must come from the same resource that hosts the deployments.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# --- Azure AI Search (retrieval) ------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=mecha-haruka
# Number of chunks retrieved per query.
RAG_TOP_K=5

# --- Azure AI Content Safety (Prompt Shields + harmful-content checks) -----
# Optional. When unset, chat still runs (system prompt, RAG grounding, and the
# Azure OpenAI default content filter remain). Severity levels are 0/2/4/6.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_THRESHOLD=4

# --- Observability (OpenTelemetry -> Azure Monitor / Application Insights) -
# Leave blank to disable tracing (the app runs unchanged; spans become no-ops).
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=mecha-haruka-backend
# Set to true to capture prompt/completion text in traces (off by default).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
