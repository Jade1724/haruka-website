# Backend configuration. Copy to `.env` and fill in. Values map to fields in
# app/core/config.py (case-insensitive). `.env` must never be committed.

# --- Dev journal source (GitHub / Obsidian) -------------------------------
# GitHub PAT with read access to the private Obsidian repo.
GITHUB_TOKEN=
GITHUB_REPO=Jade1724/obsidian
JOURNALS_BASE_PATH=Dev/Journals
CACHE_TTL_SECONDS=600

# --- Contact form (SMTP) ---------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# Log verbosity: DEBUG | INFO | WARNING | ERROR. DEBUG also un-mutes the
# Azure / OpenAI SDK logs (the verbose HTTP header dumps).
LOG_LEVEL=INFO

# --- RAG chatbot (mecha-haruka) feature flag -------------------------------
# Off by default: running the chatbot costs money (Azure OpenAI generation).
# Set to true (and fill in Azure OpenAI + DATABASE_URL below) to enable POST /chat.
CHAT_ENABLED=false

# --- Azure AI Foundry (chat generation only) -------------------------------
# Endpoint + key from the resource hosting the chat deployment. Embeddings are
# local now (see below); Foundry is used only to generate answers.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# The deployment name is what picks the model — swapping models is an env change.
# Rollback: AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_DEPLOYMENT=DeepSeek-V4-Flash
# Omit/leave empty if the deployment rejects `temperature` (some reasoning models do).
CHAT_TEMPERATURE=0.3

# --- Local embeddings (sentence-transformers) -----------------------------
# On-device query embeddings; model + dims must match the offline llm/ pipeline
# that populated the pgvector store.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# LOCAL_EMBEDDING_QUERY_PREFIX has a working default in config.py; override only
# if you change the model (preserve any required trailing space).

# --- pgvector retrieval (Postgres on the Pi) ------------------------------
# DSN for the Pi's pgvector container, e.g.
# postgresql://mechaharuka:<password>@192.168.1.124:5432/mechaharuka
DATABASE_URL=
# Number of chunks retrieved per query.
RAG_TOP_K=5

# --- RAG topology (hybrid: proxy on Vercel, local on the Pi) ---------------
# "local" = serve RAG in-process (the Pi, installed with the `rag` extra).
# "proxy" = forward /chat upstream (the Vercel deployment, base deps only).
RAG_MODE=local
# Proxy mode only: the Pi's public /chat URL (via Cloudflare Tunnel).
RAG_UPSTREAM_URL=
# Shared bearer token: the proxy sends it, the local service verifies it.
RAG_PROXY_TOKEN=

# --- Azure AI Content Safety (Prompt Shields + harmful-content checks) -----
# Optional. When unset, chat still runs (system prompt, RAG grounding, and the
# Azure OpenAI default content filter remain). Severity levels are 0/2/4/6.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_THRESHOLD=4

# --- Observability (OpenTelemetry -> Azure Monitor / Application Insights) -
# Leave blank to disable tracing (the app runs unchanged; spans become no-ops).
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=mecha-haruka-backend
# Set to true to capture prompt/completion text in traces (off by default).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
