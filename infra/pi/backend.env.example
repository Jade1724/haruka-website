# Copy to backend.env in this directory (gitignored). Pi-side secrets for the
# local RAG service; consumed by the `backend` service in compose.yaml.

# RAG runs in-process on the Pi.
RAG_MODE=local
CHAT_ENABLED=true

# Azure AI Foundry — generation only (embeddings + retrieval are local).
# Set the deployment explicitly: omitting it falls back to the default in
# config.py, which is how this host silently stayed on gpt-4o.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Shared bearer token the Vercel proxy must present to reach /chat.
# Generate one with: openssl rand -hex 32
RAG_PROXY_TOKEN=

# Azure AI Content Safety — Prompt Shields (prompt injection) + harmful-content
# checks on chat input. Optional: chat still runs without these, but the safety
# gate in rag_service is skipped entirely, so set both. main.py logs
# "Content Safety: ENABLED" / "DISABLED" at startup — check it after a restart.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# Severity levels are 0/2/4/6; input is blocked at >= this value. Defaults to 4.
CONTENT_SAFETY_THRESHOLD=4

# Required by config.py even though the Pi serves only /chat (journal + contact
# live on Vercel). Real or throwaway placeholder values are fine here.
GITHUB_TOKEN=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

# DATABASE_URL is injected by compose (points at the postgres service),
# so it does not need to be set here.
