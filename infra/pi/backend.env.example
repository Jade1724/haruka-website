# Copy to backend.env in this directory (gitignored). Pi-side secrets for the
# local RAG service; consumed by the `backend` service in compose.yaml.

# RAG runs in-process on the Pi.
RAG_MODE=local
CHAT_ENABLED=true

# Azure OpenAI — generation only (embeddings + retrieval are local).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Shared bearer token the Vercel proxy must present to reach /chat.
# Generate one with: openssl rand -hex 32
RAG_PROXY_TOKEN=

# Required by config.py even though the Pi serves only /chat (journal + contact
# live on Vercel). Real or throwaway placeholder values are fine here.
GITHUB_TOKEN=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_RECIPIENT=

# DATABASE_URL is injected by compose (points at the postgres service),
# so it does not need to be set here.
