# --- Content sources -------------------------------------------------------
# GitHub PAT with read access to the private Obsidian repo (journal source).
GITHUB_TOKEN=
GITHUB_REPO=Jade1724/obsidian
JOURNALS_BASE_PATH=Dev/Journals
# Path to the frontend content file (projects + experience). Relative to llm/.
CONTENT_JSON_PATH=../frontend/lib/content.json

# --- Azure AI Foundry (chat + embeddings) ---------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Used for BOTH generation (the system under test) and grading (RAGAS / DeepEval
# judge). Keep it in sync with the backend so evals measure what production runs;
# changing it moves the measuring stick too, so scores only compare within a model.
AZURE_OPENAI_CHAT_DEPLOYMENT=DeepSeek-V4-Flash
# Omit/leave empty if the deployment rejects `temperature`; judges then drop it too.
CHAT_TEMPERATURE=0.3
# Vector width written to the store: 384 (local bge) or 3072 (Azure text-embedding-3-large).
EMBEDDING_DIMENSIONS=384

# --- Local embeddings (sentence-transformers) -----------------------------
# Which backend embeds text: "local" (bge, on-device) or "azure" (Azure OpenAI).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# bge retrieval instruction, prepended to queries only (never to stored passages).
LOCAL_EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Azure AI Search (vector store) ---------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=mecha-haruka

# --- Chunking --------------------------------------------------------------
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- Observability (OpenTelemetry -> Azure Monitor / Application Insights) -
# Full connection string from the Application Insights resource (Overview blade).
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=mecha-haruka
# Set to true to capture prompt/completion text in traces (off by default for privacy).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# --- Self-hosting pgvector -------------------------------------------------
# Postgres/pgvector DSN. Points at the Pi's container over LAN, e.g.
# postgresql://mechaharuka:<password>@192.168.1.124:5432/mechaharuka
DATABASE_URL=
