# --- Content sources -------------------------------------------------------
# GitHub PAT with read access to the private Obsidian repo (journal source).
GITHUB_TOKEN=
GITHUB_REPO=Jade1724/obsidian
JOURNALS_BASE_PATH=Dev/Journals
# Path to the frontend content file (projects + experience). Relative to llm/.
CONTENT_JSON_PATH=../frontend/lib/content.json

# --- Azure OpenAI (chat + embeddings) -------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Judge model used by the eval harness (RAGAS / DeepEval).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
EMBEDDING_DIMENSIONS=3072

# --- Azure AI Search (vector store) ---------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=mecha-haruka

# --- Chunking --------------------------------------------------------------
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- Observability (OpenTelemetry -> Azure Monitor / Application Insights) -
# Full connection string from the Application Insights resource (Overview blade).
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=mecha-haruka
# Set to true to capture prompt/completion text in traces (off by default for privacy).
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
